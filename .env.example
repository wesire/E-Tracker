# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=economy_tracker
POSTGRES_USER=tracker_user
POSTGRES_PASSWORD=change_this_password

# Database URL (used by backend)
DATABASE_URL=postgresql://tracker_user:change_this_password@postgres:5432/economy_tracker

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# API Keys (External Data Sources)
FRED_API_KEY=your_fred_api_key_here
WORLD_BANK_API_BASE=https://api.worldbank.org/v2
OECD_API_BASE=https://sdmx.oecd.org/public/rest/data

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
LOG_LEVEL=info

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Economy Tracker

# Feature Flags
ENABLE_LLM_INSIGHTS=false
ENABLE_TIMESCALEDB=true

# Ingestion Schedule (cron format)
INGESTION_SCHEDULE=0 6 * * *

# Cache TTL (seconds)
CACHE_TTL_INDICATORS=3600
CACHE_TTL_OBSERVATIONS=1800
CACHE_TTL_INSIGHTS=900

# Rate Limiting
FRED_RATE_LIMIT_CALLS=120
FRED_RATE_LIMIT_PERIOD=60
WORLD_BANK_RATE_LIMIT_CALLS=100
WORLD_BANK_RATE_LIMIT_PERIOD=60
OECD_RATE_LIMIT_CALLS=100
OECD_RATE_LIMIT_PERIOD=60

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2
RETRY_INITIAL_DELAY=1

# Demo Mode
DEMO_MODE=false
